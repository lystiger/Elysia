#!/usr/bin/env bash
# Elysia with tools: pi harness on her local model, read-only access to the Second Brain.
C="${ELYSIA_CONTAINER:-elysia}"
if ! docker ps --format '{{.Names}}' | grep -qx "$C"; then
  echo "Elysia is asleep. Wake her from the panel, or: docker start $C"
  read -r -p "Enter to close"; exit 1
fi
JOB="elysia-pi-$(date +%Y%m%d-%H%M%S)"
LOG="$HOME/Work/agent-jobs-run/$JOB.log"
mkdir -p "$(dirname "$LOG")"; echo "Elysia (pi) started $(date -Is)" > "$LOG"
lysomarchy-agent-jobs register --id "$JOB" --task "Elysia (pi)" --agent Elysia --project Second-Brain --pid $$ --log "$LOG" 2>/dev/null && REGISTERED=1
cd "$HOME/Documents/Second-Brain" || exit 1
pi --provider ollama --model elysia --thinking off --tools read \
   --system-prompt "$(cat "$HOME/.local/share/elysia/persona.md")"
CODE=$?
echo "Elysia (pi) ended $(date -Is) exit=$CODE" >> "$LOG"
[ -n "$REGISTERED" ] && lysomarchy-agent-jobs finish --id "$JOB" --exit-code "$CODE" 2>/dev/null
exit $CODE
